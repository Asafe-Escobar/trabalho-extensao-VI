# Copie para .env  (copy .env.example .env) — NUNCA versione o .env (contém chaves)

# --- LLM: sem chave = modo mock (heurísticas, offline, gratuito) ---
ANTHROPIC_API_KEY=
LLM_MODE=auto            # auto | anthropic | mock
LLM_MODEL=claude-opus-5-5
LLM_EFFORT=low

# --- RevGás (ERP real) — ver docs/revgas-api.md ---
REVGAS_API_URL=https://api.revgas.com/v1
REVGAS_API_KEY=          # header Authorization (sem "Bearer"); peça ao responsável do projeto
REVGAS_MODO=dryrun       # dryrun (padrão: NÃO grava venda real) | real (faz POST /sales) | offline (sem rede)

# --- RAG ---
EMBEDDINGS=auto          # auto | fastembed | tfidf

# --- Banco e índice (opcional; padrão em backend/data/) ---
# FLOW_DB_PATH=data/flow.db
# FLOW_INDEX_DIR=data/index

# --- Frontend autorizado (CORS), separado por vírgula ---
CORS_ORIGINS=http://localhost:5173

# --- n8n (opcional; falha silenciosa se vazio ou fora do ar) ---
N8N_WEBHOOK_URL=             # nutrição de leads (workflow 01)
N8N_HANDOFF_WEBHOOK_URL=     # aviso de handoff para a equipe (workflow 02)
FLOW_AUTOMACAO_TOKEN=        # header X-Flow-Token exigido em /api/automacoes/* (vazio = sem token)
