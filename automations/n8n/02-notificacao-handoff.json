{
  "name": "Flow · 02 Notificação de handoff",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "flow-handoff",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "74f8ede9-8d69-57bc-9e67-ca34f72740e9",
      "name": "Webhook handoff",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "const b = $input.first().json.body || {};\nconst dados = b.dados || {};\nconst linhas = Object.entries(dados).map(([k, v]) => `• ${k}: ${typeof v === 'object' ? JSON.stringify(v) : v}`);\nconst painel = ($env.FLOW_FRONT_URL || 'http://localhost:5173') + '/atendente';\nconst urgente = /reclama|procon|quebrad|cancel|advogad/i.test((b.motivo || '') + ' ' + (b.resumo || ''));\nreturn [{ json: {\n  id: b.id, conversa_id: b.conversa_id, urgente,\n  titulo: `${urgente ? 'URGENTE · ' : ''}Handoff #${b.id} · ${b.motivo || 'pedido do cliente'}`,\n  texto: `${b.resumo || '(sem resumo)'}\\n\\n${linhas.join('\\n')}\\n\\nAbrir: ${painel}`,\n  html: `<h3>${b.motivo || 'Transferência'}</h3><p>${b.resumo || ''}</p><ul>${linhas.map(l => '<li>' + l.slice(2) + '</li>').join('')}</ul><p><a href=\"${painel}\">Abrir painel do atendente</a></p>`\n}}];"
      },
      "id": "fae96872-20a6-54d7-b775-a16b4461ada8",
      "name": "Formatar resumo",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        300
      ]
    },
    {
      "parameters": {
        "chatId": "={{ $env.TELEGRAM_CHAT_ATENDIMENTO }}",
        "text": "={{ $json.titulo }}\n\n{{ $json.texto }}",
        "additionalFields": {}
      },
      "id": "0bafd693-7ef6-55c0-9622-aa6cff43f9ea",
      "name": "Telegram equipe",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        460,
        160
      ],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "fromEmail": "={{ $env.FLOW_EMAIL_FROM || 'atendimento@flow.example' }}",
        "toEmail": "={{ $env.FLOW_EMAIL_ATENDIMENTO || 'atendimento@flow.example' }}",
        "subject": "={{ $json.titulo }}",
        "emailFormat": "html",
        "html": "={{ $json.html }}",
        "options": {}
      },
      "id": "f69819d6-4e74-560b-92d2-ea27dba61bbb",
      "name": "E-mail atendimento",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [
        460,
        320
      ],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "loose"
          },
          "combinator": "and",
          "conditions": [
            {
              "id": "c-Urgente?",
              "leftValue": "={{ $json.urgente }}",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ]
        },
        "options": {}
      },
      "id": "e8153695-565f-5703-b3dd-9630d49259b1",
      "name": "Urgente?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        460,
        500
      ]
    },
    {
      "parameters": {
        "amount": 10,
        "unit": "minutes"
      },
      "id": "0fa1a4b9-7c86-5337-8083-fe67c4d6e0d6",
      "name": "Esperar 10 min",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [
        680,
        500
      ]
    },
    {
      "parameters": {
        "url": "={{ $env.FLOW_API_URL || 'http://localhost:8000' }}/api/handoffs?status=pendente",
        "options": {}
      },
      "id": "28d76747-7d46-57fe-be53-cf16f69b576a",
      "name": "Buscar fila pendente",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        900,
        500
      ],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "loose"
          },
          "combinator": "and",
          "conditions": [
            {
              "id": "c-Ainda na fila?",
              "leftValue": "={{ $input.all().some(i => i.json.id == $('Formatar resumo').item.json.id) }}",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ]
        },
        "options": {}
      },
      "id": "db731a54-04a7-524e-8cba-e5eda3a3bcd0",
      "name": "Ainda na fila?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1120,
        500
      ]
    },
    {
      "parameters": {
        "chatId": "={{ $env.TELEGRAM_CHAT_GERENCIA }}",
        "text": "=Handoff urgente #{{ $('Formatar resumo').item.json.id }} sem atendimento há 10 min.\n{{ $('Formatar resumo').item.json.texto }}",
        "additionalFields": {}
      },
      "id": "c5cd4d9e-e3e0-51c0-970b-a92105bd699f",
      "name": "Escalar para gerente",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        1340,
        500
      ],
      "onError": "continueRegularOutput",
      "executeOnce": true
    }
  ],
  "connections": {
    "Webhook handoff": {
      "main": [
        [
          {
            "node": "Formatar resumo",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Formatar resumo": {
      "main": [
        [
          {
            "node": "Telegram equipe",
            "type": "main",
            "index": 0
          },
          {
            "node": "E-mail atendimento",
            "type": "main",
            "index": 0
          },
          {
            "node": "Urgente?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Urgente?": {
      "main": [
        [
          {
            "node": "Esperar 10 min",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Esperar 10 min": {
      "main": [
        [
          {
            "node": "Buscar fila pendente",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Buscar fila pendente": {
      "main": [
        [
          {
            "node": "Ainda na fila?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Ainda na fila?": {
      "main": [
        [
          {
            "node": "Escalar para gerente",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1",
    "timezone": "America/Fortaleza"
  },
  "tags": [
    {
      "name": "flow"
    },
    {
      "name": "atendimento"
    }
  ],
  "pinData": {}
}